{
  "name": "dsh-progress-monitor",
  "version": "0.1.0",
  "description": "Session-internal progress monitor for DeepSeek Harness: draggable floating panel tracking long-running background jobs and workflows with progress bars, a done/total count and a live ETA.",
  "license": "MIT",
  "type": "module",
  "dependencies": {},
  "scripts": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "profile": {
      "bundles": [
        "dsh-progress-monitor"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ]
}
